# Copy this file to `.env` (which is gitignored) and fill in the values.
# `.env` is auto-loaded by features/support/env.js when Cucumber starts.

# =============================================================================
# Backend API — QA environment
# =============================================================================
# Swagger UI:   https://qa-nxtstim-api.azurewebsites.net/api/docs
# Swagger JSON: https://qa-nxtstim-api.azurewebsites.net/api/docs-json
#
# Auth model (per swagger components.securitySchemes):
#   - bearer:    Authorization: Bearer <JWT> from POST /api/auth/login
#   - x-api-key: x-api-key: <API key>  (required on every endpoint)
# testApi.login(email, password) stores the bearer token in-process; subsequent
# authed calls send it automatically.
TEST_API_BASE_URL=https://qa-nxtstim-api.azurewebsites.net
TEST_API_KEY=
TEST_API_AUTH_HEADER=x-api-key

# Basic Auth on the Swagger UI page itself (/api/docs returns 401 otherwise).
# NOT sent on regular API requests — purely so scripts can refresh the spec.
SWAGGER_BASIC_USER=
SWAGGER_BASIC_PASS=

# =============================================================================
# Admin user — for the "I am logged in as an Executive Admin" Givens.
# Provision via testApi.ensureAdmin({ email, password, ... }) if not yet
# present, then fill these in. Required by all @e2e-admin scenarios.
# =============================================================================
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# =============================================================================
# Other personas — populated when scope expands beyond admin.
# =============================================================================
TEST_SUPPORT_STAFF_EMAIL=
TEST_SUPPORT_STAFF_PASSWORD=
TEST_NURSE_EMAIL=
TEST_NURSE_PASSWORD=
TEST_SUPERVISOR_EMAIL=
TEST_SUPERVISOR_PASSWORD=

# User & Role suites (NXT-1999/2000/2001): base recipient for users provisioned
# per-role at runtime. Each run gets a unique users+<tag>@domain alias that
# still forwards to the mailbox below.
USERS_EMAIL=

# =============================================================================
# Mailbox — Gmail via IMAP (Anonaddy alias forwarding supported)
# =============================================================================
# Used by features/support/gmailClient.js to read mail for the @e2e-backend
# scenarios in features/authorization/email-templates.feature and any other
# email-driven step (OTP capture, reset-link follow, etc.).
#
# Setup:
#   1) Enable 2-Step Verification on the Gmail account.
#   2) Generate an App Password at https://myaccount.google.com/apppasswords
#      (16 characters, NOT the regular account password).
#   3) If you use Anonaddy, point your aliases to the same Gmail. Aliases
#      like qa-tpl-otp@iqra.anonaddy.com will forward in and remain
#      individually searchable by To: header.
#
# The registry of automated subjects is in features/support/emailTypes.js.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# =============================================================================
# Playwright run mode
# =============================================================================
# HEADED=true is the default in features/support/hooks.js. Set HEADED=false
# in your shell or CI to override. slowMo=50ms is auto-enabled in headed mode.
HEADED=true
